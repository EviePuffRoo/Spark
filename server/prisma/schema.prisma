generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  username          String   @unique
  displayName       String?
  passwordHash      String
  recoveryCodeHash  String?
  tier              String   @default("free")
  stripeCustomerId  String?
  role              String   @default("user")
  canPublish        Boolean  @default(true)
  createdAt         DateTime @default(now())

  worlds          World[]
  characters      Character[]
  items           Item[]
  locations       Location[]
  questHooks      QuestHook[]
  factions        Faction[]
  encounterTables EncounterTable[]
  sessionNotes    SessionNote[]
  adventures      Adventure[]
  playerCharacters PlayerCharacter[]
  links           Link[]
  worldMemberships WorldMember[]
  rollLogEntries  RollLogEntry[]
  downtimeActivities DowntimeActivity[]
  codexNotes      CodexNote[]
  ledgerEntries   LedgerEntry[]
  zoneMapTemplates ZoneMapTemplate[]
  dungeons        Dungeon[]
  shops           Shop[]
  regions         Region[]
  settlements     Settlement[]
  publishedEntries PublishedEntry[]
  galleryReports  GalleryReport[]
  chatMessages    ChatMessage[]
}

model World {
  id          String      @id @default(cuid())
  name        String
  description String?
  joinCodeHash String?
  nextSessionAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  userId      String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  characters      Character[]
  items           Item[]
  locations       Location[]
  questHooks      QuestHook[]
  factions        Faction[]
  encounterTables EncounterTable[]
  sessionNotes    SessionNote[]
  adventures      Adventure[]
  playerCharacters PlayerCharacter[]
  members         WorldMember[]
  rollLogEntries  RollLogEntry[]
  downtimeActivities DowntimeActivity[]
  codexNotes      CodexNote[]
  ledgerEntries   LedgerEntry[]
  zoneMapTemplates ZoneMapTemplate[]
  dungeons        Dungeon[]
  shops           Shop[]
  regions         Region[]
  settlements     Settlement[]
  encounter       Encounter?
  chatMessages    ChatMessage[]
  base            Base?

  @@index([userId])
}

model WorldMember {
  id        String   @id @default(cuid())
  worldId   String
  world     World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([worldId, userId])
  @@index([userId])
}

model PlayerCharacter {
  id            String   @id @default(cuid())
  name          String
  className     String
  level         Int
  race          String
  armorClass    Int
  maxHp         Int
  currentHp     Int      @default(0)
  abilityScores String   @default("{}")
  playerName    String?
  tags          String   @default("[]")
  notes         String?
  equippedItems String   @default("[]")
  attunedItems  String   @default("[]")
  deathSaves    String   @default("{\"successes\":0,\"failures\":0}")
  spellSlots    String   @default("[]")
  preparedSpells String  @default("[]")
  classResources String  @default("[]")
  conditions    String   @default("[]")
  worldId       String?
  hiddenFromParty Boolean @default(false)
  world         World?   @relation(fields: [worldId], references: [id], onDelete: SetNull)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([worldId])
  @@index([userId])
}

model Character {
  id           String   @id @default(cuid())
  kind         String
  name         String
  race         String?
  background   String?
  alignment    String
  templateId   String
  templateName String
  statBlock    String
  backstory    String
  tags         String   @default("[]")
  notes        String?
  equippedItems String  @default("[]")
  attunedItems  String  @default("[]")
  worldId      String?
  hiddenFromParty Boolean @default(false)
  world        World?   @relation(fields: [worldId], references: [id], onDelete: SetNull)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([worldId])
  @@index([userId])
}

model Item {
  id          String   @id @default(cuid())
  name        String
  itemType    String
  category    String
  rarity      String
  rarityTier  Int      @default(0)
  description String
  property    String
  history     String
  bonusType   String   @default("none")
  bonusValue  Int      @default(0)
  requiresAttunement Boolean @default(false)
  charges     Int?
  rechargeRule String?
  value       Int      @default(0)
  tags        String   @default("[]")
  notes       String?
  worldId     String?
  hiddenFromParty Boolean @default(false)
  world       World?   @relation(fields: [worldId], references: [id], onDelete: SetNull)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([worldId])
  @@index([userId])
}

model Location {
  id             String   @id @default(cuid())
  name           String
  locationType   String
  category       String
  description    String
  notableFeature String
  keeper         String
  rumor          String
  tags           String   @default("[]")
  notes          String?
  worldId        String?
  hiddenFromParty Boolean @default(false)
  world          World?   @relation(fields: [worldId], references: [id], onDelete: SetNull)
  settlementId   String?
  settlement     Settlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([worldId])
  @@index([userId])
  @@index([settlementId])
}

model Region {
  id             String   @id @default(cuid())
  name           String
  terrainCategory String
  dangerLevel    String?
  description    String
  x              Float    @default(0)
  y              Float    @default(0)
  connections    String   @default("[]")
  tags           String   @default("[]")
  notes          String?
  worldId        String?
  hiddenFromParty Boolean @default(false)
  world          World?   @relation(fields: [worldId], references: [id], onDelete: SetNull)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  settlements    Settlement[]

  @@index([worldId])
  @@index([userId])
}

model Settlement {
  id             String   @id @default(cuid())
  name           String
  settlementType String
  population     String?
  government     String?
  description    String
  regionId       String?
  region         Region?  @relation(fields: [regionId], references: [id], onDelete: SetNull)
  tags           String   @default("[]")
  notes          String?
  worldId        String?
  hiddenFromParty Boolean @default(false)
  world          World?   @relation(fields: [worldId], references: [id], onDelete: SetNull)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  locations      Location[]

  @@index([worldId])
  @@index([userId])
  @@index([regionId])
}

model QuestHook {
  id           String   @id @default(cuid())
  title        String
  questType    String
  tier         String
  hook         String
  objective    String
  complication String
  reward       String
  status       String   @default("active")
  tags         String   @default("[]")
  notes        String?
  worldId      String?
  hiddenFromParty Boolean @default(false)
  world        World?   @relation(fields: [worldId], references: [id], onDelete: SetNull)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([worldId])
  @@index([userId])
}

model Faction {
  id          String   @id @default(cuid())
  name        String
  factionType String
  agenda      String
  methods     String
  publicFace  String
  hook        String
  tags        String   @default("[]")
  notes       String?
  worldId     String?
  hiddenFromParty Boolean @default(false)
  reputation  Int      @default(0)
  world       World?   @relation(fields: [worldId], references: [id], onDelete: SetNull)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([worldId])
  @@index([userId])
}

model EncounterTable {
  id        String   @id @default(cuid())
  name      String
  terrain   String
  entries   String
  tags      String   @default("[]")
  notes     String?
  worldId   String?
  hiddenFromParty Boolean @default(false)
  world     World?   @relation(fields: [worldId], references: [id], onDelete: SetNull)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([worldId])
  @@index([userId])
}

model ZoneMapTemplate {
  id        String   @id @default(cuid())
  name      String
  zones     String
  tags      String   @default("[]")
  notes     String?
  worldId   String?
  hiddenFromParty Boolean @default(false)
  world     World?   @relation(fields: [worldId], references: [id], onDelete: SetNull)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([worldId])
  @@index([userId])
}

model Dungeon {
  id        String   @id @default(cuid())
  name      String
  rooms     String
  tags      String   @default("[]")
  notes     String?
  worldId   String?
  hiddenFromParty Boolean @default(false)
  world     World?   @relation(fields: [worldId], references: [id], onDelete: SetNull)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([worldId])
  @@index([userId])
}

model Shop {
  id          String   @id @default(cuid())
  name        String
  description String?
  stock       String
  tags        String   @default("[]")
  notes       String?
  worldId     String?
  hiddenFromParty Boolean @default(false)
  world       World?   @relation(fields: [worldId], references: [id], onDelete: SetNull)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([worldId])
  @@index([userId])
}

model SessionNote {
  id           String   @id @default(cuid())
  title        String
  sessionLabel String?
  sessionDate  DateTime?
  summary      String
  looseThreads String?
  nextSteps    String?
  tags         String   @default("[]")
  notes        String?
  worldId      String?
  hiddenFromParty Boolean @default(false)
  world        World?   @relation(fields: [worldId], references: [id], onDelete: SetNull)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([worldId])
  @@index([userId])
}

model Adventure {
  id           String   @id @default(cuid())
  title        String
  tier         String
  premise      String
  hook         String
  objective    String
  complication String
  reward       String
  tags         String   @default("[]")
  notes        String?
  worldId      String?
  hiddenFromParty Boolean @default(false)
  world        World?   @relation(fields: [worldId], references: [id], onDelete: SetNull)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([worldId])
  @@index([userId])
}

model RollLogEntry {
  id              String   @id @default(cuid())
  worldId         String
  world           World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rollerName      String
  notation        String
  results         String
  modifier        Int      @default(0)
  total           Int
  mode            String?
  label           String?
  hiddenFromParty Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([worldId])
  @@index([userId])
}

// senderName is stamped server-side from the poster's own username, not
// client-supplied like RollLogEntry.rollerName — chat is an identity-bound
// conversation, not a "which PC rolled this" label, so it shouldn't be
// spoofable. No hidden/secret variant either; everyone with world access
// sees the same feed.
model ChatMessage {
  id         String   @id @default(cuid())
  worldId    String
  world      World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderName String
  text       String
  createdAt  DateTime @default(now())

  @@index([worldId])
  @@index([userId])
}

model DowntimeActivity {
  id                String   @id @default(cuid())
  worldId           String
  world             World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playerCharacterId String?
  characterName     String
  activityType      String
  description       String
  daysSpent         Int
  outcome           String?
  createdAt         DateTime @default(now())

  @@index([worldId])
  @@index([userId])
}

model CodexNote {
  id         String   @id @default(cuid())
  worldId    String
  world      World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  authorName String
  text       String
  createdAt  DateTime @default(now())

  @@index([worldId, entityType, entityId])
  @@index([userId])
}

model LedgerEntry {
  id         String   @id @default(cuid())
  worldId    String
  world      World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String
  label      String
  amount     Int
  authorName String
  createdAt  DateTime @default(now())

  @@index([worldId])
  @@index([userId])
}

model Encounter {
  id          String   @id @default(cuid())
  worldId     String   @unique
  world       World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  combatants  String
  round       Int      @default(1)
  turnIndex   Int      @default(0)
  zones       String   @default("[]")
  zoneEffects String   @default("[]")
  activeDungeonId     String?
  activeDungeonRoomId String?
  updatedAt   DateTime @updatedAt
}

// One home base per world — a shared party resource, not owned by a single
// user, same shape as Encounter above. Level is deliberately not stored
// here; it's derived from the count of BaseUpgrade rows so there's no
// separate counter that can drift out of sync with what's actually owned.
model Base {
  id        String   @id @default(cuid())
  worldId   String   @unique
  world     World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  name      String   @default("The Party's Outpost")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  upgrades  BaseUpgrade[]
}

// A purchased upgrade, referencing a curated static definition
// (BASE_UPGRADES in shared) by id rather than duplicating its content here.
model BaseUpgrade {
  id         String   @id @default(cuid())
  baseId     String
  base       Base     @relation(fields: [baseId], references: [id], onDelete: Cascade)
  upgradeId  String
  acquiredAt DateTime @default(now())
  // Set when this upgrade's effect generated a real Shop at purchase time.
  // No FK — same "no relation to the source row" shape as PublishedEntry
  // below, so deleting the shop later doesn't cascade into the purchase
  // record or vice versa.
  shopId     String?

  @@unique([baseId, upgradeId])
  @@index([baseId])
}

// A user-owned entity published to the public gallery, browsable/cloneable
// by any signed-in account. No FK to the source row — Prisma can't express
// a polymorphic relation across the ~14 entity tables entityType can name —
// so a row whose source was later deleted becomes a harmless orphan that
// GET /api/public simply skips (its adapter lookup returns null) rather
// than being actively cleaned up from every entity's DELETE route.
model PublishedEntry {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  // Set on admin takedown. The row is kept (soft delete) rather than
  // removed, so the report/audit trail survives — every read path filters
  // on removedAt: null, the same shape as the orphan-skip above.
  removedAt       DateTime?
  removedReason   String?
  removedByUserId String?

  reports     GalleryReport[]

  @@index([entityType])
  @@index([userId])
}

// A user flag on a published gallery entry. One report per user per entry
// (see the unique constraint below) — repeat-reporting the same entry
// doesn't inflate its queue weight.
model GalleryReport {
  id          String    @id @default(cuid())
  entryId     String
  entry       PublishedEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  reporterId  String
  reporter    User      @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason      String
  detail      String?
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  resolvedByUserId String?

  @@unique([entryId, reporterId])
  @@index([status])
  @@index([entryId])
}

model Link {
  id        String   @id @default(cuid())
  fromType  String
  fromId    String
  toType    String
  toId      String
  label     String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([fromType, fromId])
  @@index([toType, toId])
  @@index([userId])
}
