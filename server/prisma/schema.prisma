generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model World {
  id          String      @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  characters  Character[]
  items       Item[]
  locations   Location[]
  questHooks  QuestHook[]
}

model Character {
  id           String   @id @default(cuid())
  kind         String
  name         String
  race         String?
  background   String?
  alignment    String
  templateId   String
  templateName String
  statBlock    String
  backstory    String
  tags         String   @default("[]")
  notes        String?
  worldId      String?
  world        World?   @relation(fields: [worldId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([worldId])
}

model Item {
  id          String   @id @default(cuid())
  name        String
  itemType    String
  category    String
  rarity      String
  description String
  property    String
  history     String
  tags        String   @default("[]")
  notes       String?
  worldId     String?
  world       World?   @relation(fields: [worldId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([worldId])
}

model Location {
  id             String   @id @default(cuid())
  name           String
  locationType   String
  category       String
  description    String
  notableFeature String
  keeper         String
  rumor          String
  tags           String   @default("[]")
  notes          String?
  worldId        String?
  world          World?   @relation(fields: [worldId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([worldId])
}

model QuestHook {
  id           String   @id @default(cuid())
  title        String
  questType    String
  tier         String
  hook         String
  objective    String
  complication String
  reward       String
  tags         String   @default("[]")
  notes        String?
  worldId      String?
  world        World?   @relation(fields: [worldId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([worldId])
}
