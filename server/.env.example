DATABASE_URL="file:./dev.db"
PORT=4000

# Optional — billing is fully functional without these (the checkout/portal
# routes just return 503 until they're set). Get them from the Stripe
# dashboard: a secret key, a webhook signing secret for the endpoint at
# /api/billing/webhook, and the Price ID for the paid subscription.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
