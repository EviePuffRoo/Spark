DATABASE_URL="file:./dev.db"
PORT=4000

# Optional locally — falls back to an insecure dev-only secret so signup/
# login work out of the box. render.yaml generates a real one for the
# deployed service, and auth.ts refuses to start there without it.
JWT_SECRET=

# Optional — billing is fully functional without these (the checkout/portal
# routes just return 503 until they're set). Get them from the Stripe
# dashboard: a secret key, a webhook signing secret for the endpoint at
# /api/billing/webhook, and the Price ID for the paid subscription.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Optional — automated daily database backups are fully functional without
# these; scheduling just no-ops with a log line if any are missing. Backs
# up to a Cloudflare R2 bucket via its S3-compatible API. Get the account
# ID and an API token (with read+write access to the bucket) from the
# Cloudflare dashboard, under R2 > Manage R2 API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Optional — the live SSE channel (encounter/ledger/roll-log/chat updates)
# is fully functional without this as long as Spark runs as a single server
# instance (today's deployment). Set this only if you scale to more than one
# instance behind a load balancer: it lets a change published on one
# instance reach SSE connections held open on another, via Redis pub/sub.
REDIS_URL=
