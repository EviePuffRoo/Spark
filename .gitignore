node_modules/
dist/
dist-ssr/
*.local

# Prisma / SQLite
# Any local SQLite database and its journal — dev.db, test.db, e2e.db, and
# whatever one-off name a scratch database gets next.
server/prisma/*.db
server/prisma/*.db-journal
server/.env

# Playwright
client/test-results/
client/playwright-report/

.DS_Store
*.log

# One-off Playwright specs used to drive the real app for screenshots or
# manual verification, and whatever they capture. These are scratch work,
# not tests — committing one would also add it to the e2e suite CI runs.
client/e2e/tmp-*
client/showcase-out/
